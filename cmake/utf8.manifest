<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Windows: run with UTF-8 as the process's code page (Windows 10 1903 and
     later), so argv, fopen and the other narrow-string APIs take UTF-8 and
     paths with any characters work (a user folder named "José", Cyrillic,
     ...). Embedded in H3Recomp, XenonRecomp and h3xexinfo (CMakeLists.txt;
     the H3Recomp that h3setup links gets runtime/utf8.res). -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
